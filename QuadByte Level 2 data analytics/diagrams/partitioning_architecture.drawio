        <!-- Callout Banner -->
        <mxCell id="callout_box" value="&lt;b&gt;Architectural Principle:&lt;/b&gt; Range Partitioning enables instant Partition Pruning on temporal queries (95% of OLTP traffic).&lt;br/&gt;&lt;span style=&quot;color: #64748B;&quot;&gt;Hash Partitioning balances concurrent user write locks and keeps B-Tree indexes pinned in RAM.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
