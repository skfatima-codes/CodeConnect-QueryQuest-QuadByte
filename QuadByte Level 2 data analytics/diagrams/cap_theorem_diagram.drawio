        <!-- AP Cluster Box -->
        <mxCell id="ap_box" value="&lt;b style=&quot;font-size: 13px; color: #0F766E;&quot;&gt;AP CLUSTER (High Availability)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Real-time Rider GPS Tracking&lt;/b&gt; (3s telemetry)&lt;br/&gt;• &lt;b&gt;Restaurant &amp;amp; Menu Catalog Browsing&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Customer Review Feeds &amp;amp; Ratings&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;i style=&quot;color: #0F766E; font-size: 11px;&quot;&gt;Network Partition ➔ Serve stale read cache&lt;br/&gt;Prioritize zero customer downtime.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;verticalAlign=top;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="1">
