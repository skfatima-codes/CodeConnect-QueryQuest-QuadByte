        <!-- Footer Callout -->
        <mxCell id="callout" value="&lt;b&gt;Fundamental Law:&lt;/b&gt; Network partitions (P) are an unavoidable physical reality in distributed infrastructure.&lt;br/&gt;&lt;span style=&quot;color: #64748B;&quot;&gt;When physical links fail, systems MUST choose between CP (Consistency) or AP (Availability).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
