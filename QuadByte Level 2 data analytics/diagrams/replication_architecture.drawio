  <diagram id="repl-arch" name="Replication Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="hdr" value="&lt;b style=&quot;font-size: 18px; color: #0F172A;&quot;&gt;PostgreSQL Master-Replica Replication Topology (80% Read / 20% Write)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- Client Layer -->
        <mxCell id="client_box" value="&lt;b style=&quot;font-size: 14px; color: #1E293B;&quot;&gt;Client Layer&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Web Ordering App&lt;br/&gt;• Mobile App (iOS / Android)&lt;br/&gt;• Rider Logistics App&lt;br/&gt;• Merchant Portal&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #B45309;&quot;&gt;10x Ramadan Spike&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #92400E;&quot;&gt;(500k orders/day)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="250" as="geometry" />
        </mxCell>

        <!-- Proxy Layer -->
        <mxCell id="proxy_box" value="&lt;b style=&quot;font-size: 14px; color: #1E40AF;&quot;&gt;Routing &amp;amp; Proxy Layer&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #2563EB;&quot;&gt;HAProxy + PgBouncer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #64748B;&quot;&gt;Connection Pooling &amp;amp; Routing&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #1E3A8A;&quot;&gt;Read-Your-Writes Router&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Pins reads for 5s after write&lt;br/&gt;Eliminates replication lag race&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;Port 5432 ➔ Primary (Writes)&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #059669;&quot;&gt;Port 5433 ➔ Replicas (Reads)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="240" height="290" as="geometry" />
        </mxCell>

        <!-- Primary DB -->
        <mxCell id="primary_db" value="&lt;b style=&quot;font-size: 14px; color: #991B1B;&quot;&gt;Primary PostgreSQL Node (Writer)&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #B91C1C;&quot;&gt;20% Traffic: INSERT / UPDATE / FOR UPDATE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #7F1D1D;&quot;&gt;ACID Transactions • Order Transitions • Financial Ledger&lt;br/&gt;Master WAL Sequence: pg_current_wal_lsn()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="90" width="340" height="110" as="geometry" />
        </mxCell>

        <!-- Read Replicas -->
        <mxCell id="read_replicas" value="&lt;b style=&quot;font-size: 14px; color: #065F46;&quot;&gt;Read Replica 1 &amp;amp; 2 (Active Readers)&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #047857;&quot;&gt;80% Traffic: Menus, Catalog Search, Reviews&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #047857;&quot;&gt;Round-Robin Load Balanced via PgBouncer Pool&lt;br/&gt;Auto-Scales from 2 to 6 Nodes During Ramadan Peaks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="340" height="115" as="geometry" />
        </mxCell>

